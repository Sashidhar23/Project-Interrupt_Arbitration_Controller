# sensor_oled_top only. Do not load standalone ACL2/HYGRO/OLED XDCs with this.
# ACL2=JA (INT1 on JA8), HYGRO=JB3 SCL / JB4 SDA, OLED=JC 12-pin connector.
# JC1=CS, JC2=SDIN, JC3 unused, JC4=SCLK, JC7=DC, JC8=RES, JC9=VBATC, JC10=VDDC.
# Physical JC pins 1,2,3,4,7,8,9,10 = JC1_P,JC1_N,JC2_P,JC2_N,JC3_P,JC3_N,JC4_P,JC4_N.
# Verified against ZedBoard schematic sheet 3; master XDC lists N before P, not connector order.
# Source: https://github.com/Digilent/digilent-xdc/blob/master/Zedboard-Master.xdc
# BTNC bank voltage MUST match the actual board VADJ jumper.
set VADJ_IOSTANDARD LVCMOS18
set_property PACKAGE_PIN Y9 [get_ports {clk}]
set_property PACKAGE_PIN P16 [get_ports {btn_rst}]
set_property PACKAGE_PIN Y11 [get_ports {acl2_cs_n}]
set_property PACKAGE_PIN AA11 [get_ports {acl2_mosi}]
set_property PACKAGE_PIN Y10 [get_ports {acl2_miso}]
set_property PACKAGE_PIN AA9 [get_ports {acl2_sclk}]
set_property PACKAGE_PIN AB10 [get_ports {acl2_int1}]
set_property PACKAGE_PIN V10 [get_ports {hygro_scl}]
set_property PACKAGE_PIN W8 [get_ports {hygro_sda}]
set_property PACKAGE_PIN AB7 [get_ports {oled_cs_n}]
set_property PACKAGE_PIN AB6 [get_ports {oled_sdin}]
set_property PACKAGE_PIN AA4 [get_ports {oled_sclk}]
set_property PACKAGE_PIN R6 [get_ports {oled_dc}]
set_property PACKAGE_PIN T6 [get_ports {oled_res_n}]
set_property PACKAGE_PIN T4 [get_ports {oled_vbatc_n}]
set_property PACKAGE_PIN U4 [get_ports {oled_vddc_n}]
set_property PACKAGE_PIN T22 [get_ports {led[0]}]
set_property PACKAGE_PIN T21 [get_ports {led[1]}]
set_property PACKAGE_PIN U22 [get_ports {led[2]}]
set_property PACKAGE_PIN U21 [get_ports {led[3]}]
set_property PACKAGE_PIN V22 [get_ports {led[4]}]
set_property PACKAGE_PIN W22 [get_ports {led[5]}]
set_property PACKAGE_PIN U19 [get_ports {led[6]}]
set_property PACKAGE_PIN U14 [get_ports {led[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {clk acl2_* hygro_* oled_* led[*]}]
set_property IOSTANDARD $VADJ_IOSTANDARD [get_ports btn_rst]
set_property SLEW SLOW [get_ports {acl2_cs_n acl2_mosi acl2_sclk hygro_* oled_*}]
create_clock -period 10.000 -name sys_clk [get_ports clk]
# Low-rate buses are clock-enable driven; inputs cross synchronizers.
# These board-bring-up exceptions are not a source-synchronous SPI timing proof.
set_false_path -from [get_ports {btn_rst acl2_int1 acl2_miso hygro_scl hygro_sda}]
set_false_path -to [get_ports {led[*]}]
# Peripheral clocks are generated by clock enables, not external 100 MHz receivers.
# Bound register-to-pin propagation to 20 ns. At the default slow bus rates,
# OLED has 240 ns data setup before SCLK rises, ACL2 has a 500 ns half-period,
# and I2C has microsecond phases. This is a propagation/skew budget; verify
# receiver setup/hold and board traces separately. Do not substitute 100 MHz
# set_output_delay constraints for those peripheral sampling edges.
set_max_delay 20.000 -datapath_only -from [get_clocks sys_clk] -to [get_ports {acl2_cs_n acl2_mosi acl2_sclk oled_* hygro_*}]
