# JB header version. Use INSTEAD of oled_dbg.xdc and plug the OLED into JB. Verify pins vs Zedboard reference.
set_property -dict {PACKAGE_PIN Y9   IOSTANDARD LVCMOS33} [get_ports clk]
create_clock -period 10.000 -name sys_clk [get_ports clk]
set_property -dict {PACKAGE_PIN P16  IOSTANDARD LVCMOS33} [get_ports btn_rst]
set_property -dict {PACKAGE_PIN W12  IOSTANDARD LVCMOS33} [get_ports oled_cs_n]
set_property -dict {PACKAGE_PIN W11 IOSTANDARD LVCMOS33} [get_ports oled_sdin]
set_property -dict {PACKAGE_PIN W8   IOSTANDARD LVCMOS33} [get_ports oled_sclk]
set_property -dict {PACKAGE_PIN V12 IOSTANDARD LVCMOS33} [get_ports oled_dc]
set_property -dict {PACKAGE_PIN W10 IOSTANDARD LVCMOS33} [get_ports oled_res_n]
set_property -dict {PACKAGE_PIN V9   IOSTANDARD LVCMOS33} [get_ports oled_vbatc_n]
set_property -dict {PACKAGE_PIN V8   IOSTANDARD LVCMOS33} [get_ports oled_vddc_n]
set_property -dict {PACKAGE_PIN T22 IOSTANDARD LVCMOS33} [get_ports {led[0]}]
set_property -dict {PACKAGE_PIN T21 IOSTANDARD LVCMOS33} [get_ports {led[1]}]
set_property -dict {PACKAGE_PIN U22 IOSTANDARD LVCMOS33} [get_ports {led[2]}]
set_property -dict {PACKAGE_PIN U21 IOSTANDARD LVCMOS33} [get_ports {led[3]}]
set_property -dict {PACKAGE_PIN V22 IOSTANDARD LVCMOS33} [get_ports {led[4]}]
set_property -dict {PACKAGE_PIN W22 IOSTANDARD LVCMOS33} [get_ports {led[5]}]
set_property -dict {PACKAGE_PIN U19 IOSTANDARD LVCMOS33} [get_ports {led[6]}]
set_property -dict {PACKAGE_PIN U14 IOSTANDARD LVCMOS33} [get_ports {led[7]}]
